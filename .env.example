TEKKEN_ID=YourTekkenID
POLARIS_ID=YourPolarisID
CHARA_ID=45

# 複数プレイヤー設定（POLARIS_ID より優先される）
# PLAYERS=ExodusOverseer:polaris_id1,Tanaka:polaris_id2

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# オプション: ewgf.gg APIキー（https://ewgf.gg で取得）
EWGF_API_KEY=your_key_here

# オプション: Ollama（ローカルLLM）
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# オプション: ログファイルパス
LOG_PATH=/app/data/tekken_bot.log
