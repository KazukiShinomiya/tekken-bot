TEKKEN_ID=YourTekkenID
POLARIS_ID=YourPolarisID
CHARA_ID=45

# 複数プレイヤー設定（POLARIS_ID より優先される）
# PLAYERS=ExodusOverseer:polaris_id1,Tanaka:polaris_id2

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_BOT_TOKEN=your_bot_token_here

# オプション: エラー専用 Webhook（設定するとエラー通知が別チャンネルに届く）
# 未設定の場合は DISCORD_WEBHOOK_URL に通知される
# DISCORD_ERROR_WEBHOOK_URL=https://discord.com/api/webhooks/...

# オプション: ewgf.gg APIキー（https://ewgf.gg で取得）
EWGF_API_KEY=your_key_here

# オプション: Ollama（ローカルLLM）
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_FALLBACK_MODEL=gemma3:4b

# オプション: Gemini（Ollama 完全失敗時の最終フォールバック）
# 無料枠: 15 RPM / 1M tokens/day。未設定の場合は Gemini フォールバック無効。
# APIキー取得: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# オプション: ログファイルパス
LOG_PATH=/app/data/tekken_bot.log
